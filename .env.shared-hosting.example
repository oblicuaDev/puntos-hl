# Plantilla de .env para el escenario "hosting compartido de cPanel, sin
# Docker/Redis/Node/Supervisor" (ver docs/08-despliegue/05-alternativa-hosting-compartido.md).
# Copiar a `.env` en el servidor, completar y nunca commitear.

APP_NAME="HL Puntos"
APP_ENV=production
APP_KEY=                       # generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://puntos.harkerlloreda.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=                   # base MySQL creada desde cPanel (MySQL Databases)
DB_USERNAME=
DB_PASSWORD=

# Sin Redis en este escenario: todo corre sobre la misma MySQL (las tablas
# `cache` y `jobs` ya existen de fábrica, no hacen falta migraciones nuevas).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=puntos.harkerlloreda.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=hlfid_

# --- SMTP transaccional real (pendiente definir proveedor) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="puntos@harkerlloreda.com"
MAIL_FROM_NAME="${APP_NAME}"
MANAGEMENT_NOTIFICATION_EMAIL=gerencia@harkerlloreda.com

VITE_APP_NAME="${APP_NAME}"

# --- SSO con WordPress headless (webadmin.harkerlloreda.com) ---
WP_SSO_ISSUER=https://webadmin.harkerlloreda.com
WP_SSO_SHARED_SECRET=

# --- Payzen/Izipay (Lyra) — deben ser credenciales NUEVAS post-incidente ---
PAYMENTS_DRIVER=stub
PAYZEN_SHOP_ID=
PAYZEN_PUBLIC_KEY=
PAYZEN_API_PASSWORD=
PAYZEN_HMAC_KEY_PROD=
PAYZEN_MODE=PRODUCTION
