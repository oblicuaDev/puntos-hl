# Plantilla para el .env real del VPS. Copiar a `.env`, completar los valores
# marcados y NUNCA commitear el resultado (ya está en .gitignore).

APP_NAME="HL Puntos"
APP_ENV=production
APP_KEY=                       # generar con: docker compose -f docker-compose.prod.yml exec app php artisan key:generate
APP_DEBUG=false
APP_URL=https://puntos.harkerlloreda.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hl_fidelizacion
DB_USERNAME=hl_fidelizacion
DB_PASSWORD=                   # generar una contraseña fuerte, distinta de dev
DB_ROOT_PASSWORD=              # solo la usa el contenedor mysql al crearse, no la app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=puntos.harkerlloreda.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=hlfid_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- SMTP transaccional real (pendiente definir proveedor; ver docs/08-despliegue) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="puntos@harkerlloreda.com"
MAIL_FROM_NAME="${APP_NAME}"
MANAGEMENT_NOTIFICATION_EMAIL=gerencia@harkerlloreda.com

VITE_APP_NAME="${APP_NAME}"

# --- SSO con WordPress headless (webadmin.harkerlloreda.com) ---
# Debe ser el MISMO secreto configurado en el plugin hl-puntos-sso-bridge de WP.
WP_SSO_ISSUER=https://webadmin.harkerlloreda.com
WP_SSO_SHARED_SECRET=

# --- Payzen/Izipay (Lyra) ---
# Dejar en "stub" hasta que Katherine entregue credenciales reales.
PAYMENTS_DRIVER=stub
PAYZEN_SHOP_ID=
PAYZEN_PUBLIC_KEY=
PAYZEN_API_PASSWORD=
PAYZEN_HMAC_KEY_PROD=
PAYZEN_MODE=PRODUCTION
