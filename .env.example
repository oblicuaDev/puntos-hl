APP_NAME="HL Puntos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hl_fidelizacion
DB_USERNAME=hl_fidelizacion
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=hlfid_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="puntos@harkerlloreda.com"
MAIL_FROM_NAME="${APP_NAME}"
MANAGEMENT_NOTIFICATION_EMAIL=gerencia@harkerlloreda.com

HARKER_SITE_URL=https://harkerlloreda.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SSO con WordPress headless (webadmin.harkerlloreda.com) ---
WP_SSO_ISSUER=
WP_SSO_SHARED_SECRET=

# --- Payzen/Izipay (Lyra) ---
# PAYMENTS_DRIVER=stub hasta que Katherine entregue credenciales reales; luego cambiar a "payzen"
PAYMENTS_DRIVER=stub
PAYZEN_SHOP_ID=
PAYZEN_PUBLIC_KEY=
PAYZEN_API_PASSWORD=
PAYZEN_HMAC_KEY_TEST=
PAYZEN_HMAC_KEY_PROD=
PAYZEN_MODE=TEST
